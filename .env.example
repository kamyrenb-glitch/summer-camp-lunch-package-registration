# Example settings. Copy this file to a new file named .env and fill in real values.
# .env is ignored by git, so your real values are never committed.
# Never put real passwords or keys in this example file.

# A long random string used to sign the session cookie.
# Create one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Required when DATABASE_URL is set. For local development it can be left out.
SECRET_KEY=

# The PostgreSQL connection string for the deployed database (Supabase).
# Leave this commented out to use the local SQLite database in instance/.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
